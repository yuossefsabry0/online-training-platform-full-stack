              "path": ["admin", "audit-log"],
              "query": [
                {
                  "key": "page",
                  "value": "{{page}}",
                  "description": "Page number (1-indexed)"
                },
                {
                  "key": "pageSize",
                  "value": "{{pageSize}}",
                  "description": "Items per page (max 100)"
                }
              ]
            },
