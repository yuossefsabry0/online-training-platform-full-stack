        {
          "name": "Reduce member subscription",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"days\": 5\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/members/{{userId}}/reduce",
              "host": ["{{baseUrl}}"],
              "path": ["members", "{{userId}}", "reduce"]
            },
            "description": "Subtracts days from a member's subscription. If reduced to zero or below, triggers full expiration logic. Requires ADMIN role."
          },
          "response": []
        },
        {
          "name": "Cancel member subscription",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/members/{{userId}}/cancel",
              "host": ["{{baseUrl}}"],
              "path": ["members", "{{userId}}", "cancel"]
            },
            "description": "Immediately cancels a member's subscription (full expiration logic). Requires ADMIN role."
          },
          "response": []
        }
      ]
    },
