          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/admin/deleted-accounts?page={{page}}&pageSize={{pageSize}}",
              "host": ["{{baseUrl}}"],
              "path": ["admin", "deleted-accounts"],
              "query": [
                {
                  "key": "page",
                  "value": "{{page}}",
