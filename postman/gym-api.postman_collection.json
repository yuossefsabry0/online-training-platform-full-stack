              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/members/{{userId}}/change-plan",
              "host": ["{{baseUrl}}"],
              "path": ["members", "{{userId}}", "change-plan"]
            },
            "description": "Replaces a member's plan duration. Allowed values: 1, 3, 6, 12. Requires ADMIN role."
          },
          "response": []
