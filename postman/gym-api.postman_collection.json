              "raw": "{{baseUrl}}/admin/deleted-accounts/{{deletedAccountId}}",
              "host": ["{{baseUrl}}"],
              "path": ["admin", "deleted-accounts", "{{deletedAccountId}}"]
            },
            "description": "SUPER_ADMIN only. Permanently removes an archived account record. Set `deletedAccountId` from the deleted-accounts list."
          },
          "response": []
