# ─── Required ───────────────────────────────────────────────
DATABASE_URL=mysql://user:password@localhost:3306/gym_db
JWT_ACCESS_SECRET=replace-with-a-long-random-string
JWT_REFRESH_SECRET=replace-with-a-different-long-random-string

# ─── Optional ───────────────────────────────────────────────
# NODE_ENV=development
# PORT=3000

# ─── CORS (comma-separated origins; REQUIRED in production) ─
# CORS_ORIGINS=http://localhost:3000

# ─── Token lifetimes ────────────────────────────────────────
# ACCESS_TOKEN_TTL=24h
# REFRESH_TOKEN_TTL_SECONDS=86400

# ─── Mail ────────────────────────────────────────────────────
# MAIL_FROM=gym-api@localhost

# ─── Subscription expiry ────────────────────────────────────
# EXPIRY_WARNING_DAYS=3

# ─── Contact-us page defaults ───────────────────────────────
# CONTACT_GYM_PHONE=+20-100-000-0000
# CONTACT_GYM_EMAIL=contact@gym.example
# CONTACT_ADDRESS=12 Tahrir Square, Cairo
# CONTACT_HOURS=06:00 - 23:00 daily

# ─── Rate limits (signup / forgot-password / delete-account) ─
# SIGNUP_RATE_LIMIT_WINDOW_MINUTES=15
# SIGNUP_RATE_LIMIT_MAX=10
# FORGOT_PASSWORD_RATE_LIMIT_WINDOW_MINUTES=15
# FORGOT_PASSWORD_RATE_LIMIT_MAX=5
# DELETE_ACCOUNT_RATE_LIMIT_WINDOW_MINUTES=15
# DELETE_ACCOUNT_RATE_LIMIT_MAX=5

# ─── Smoke test ─────────────────────────────────────────────
# GYM_API_URL=http://localhost:3000/api
# SMOKE_ADMIN_USERNAME=ahmed
# SMOKE_ADMIN_PASSWORD=Coach@123
# SMOKE_SUPERADMIN_USERNAME=superadmin
# SMOKE_SUPERADMIN_PASSWORD=Super@123
